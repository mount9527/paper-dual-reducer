{
  "name": "dsh-paper-dual",
  "version": "0.8.2",
  "description": "论文双降工作台：诊断中文论文 .doc/.docx 的 AI 文风与篇内重复，AIGC 考官打分 + 9 维痕迹诊断，闭环改写与三栏对照。",
  "type": "module",
  "license": "MIT",
  "author": "mount9527",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "aigc",
    "plagiarism",
    "academic-writing",
    "de-ai",
    "docx",
    "chinese"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mount9527/paper-dual-reducer.git"
  },
  "homepage": "https://github.com/mount9527/paper-dual-reducer#readme",
  "bugs": {
    "url": "https://github.com/mount9527/paper-dual-reducer/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "aigc/detector.py",
    "aigc/diag.py",
    "aigc/segscore.py",
    "aigc/segdiag.py",
    "aigc/selftest.py",
    "aigc/SPEC.md",
    "aigc/requirements.txt",
    "aigc/samples/*.txt",
    "docs/design.md",
    "docs/images/*.png",
    "README.md",
    "aigc/blocking.py",
    "aigc/bands.py",
    "aigc/calib.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
